# 复制为 .env 并填入你的 DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：模型名（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：API 地址（默认 https://api.deepseek.com，也可以填其他 OpenAI 兼容地址）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：监听地址和端口。想用手机在局域网里玩，可以把 AVALON_HOST 设为 0.0.0.0
# AVALON_HOST=127.0.0.1
# AVALON_PORT=8765
